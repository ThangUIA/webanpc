@model IEnumerable<WebBanPC.Models.Voucher>
@{
    ViewData["Title"] = "Quản Lý Voucher";
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-1"><i class="fas fa-ticket-alt me-2"></i>Danh Sách Mã Giảm Giá</h3>
            <p class="text-muted mb-0">Quản lý các mã khuyến mãi và chiến dịch giảm giá đơn hàng</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="fas fa-plus me-1"></i> Tạo Voucher Mới
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 ms-2">
                <i class="fas fa-arrow-left me-1"></i> Trang Chủ
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-nowrap">
                    <tr>
                        <th class="ps-4">Mã Voucher</th>
                        <th>Chương Trình</th>
                        <th>Số Tiền Giảm</th>
                        <th>Đơn Tối Thiểu</th>
                        <th>Số Lượng Còn</th>
                        <th>Hạn Dùng</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-warning text-dark font-monospace fs-6 px-2 py-1">@item.Code</span>
                                </td>
                                <td><strong class="text-dark">@item.Title</strong></td>
                                <td class="text-danger fw-bold">-@item.DiscountAmount.ToString("N0") đ</td>
                                <td>@item.MinOrderAmount.ToString("N0") đ</td>
                                <td>
                                    <span class="badge @(item.Quantity > 0 ? "bg-info text-dark" : "bg-danger")">
                                        @item.Quantity lượt
                                    </span>
                                </td>
                                <td>
                                    <small class="text-muted d-block">Từ: @item.StartDate.ToString("dd/MM/yyyy")</small>
                                    <small class="text-muted d-block">Đến: @item.EndDate.ToString("dd/MM/yyyy")</small>
                                </td>
                                <td>
                                    @if (item.IsActive && item.EndDate >= DateTime.Now && item.Quantity > 0)
                                    {
                                        <span class="badge bg-success rounded-pill px-2 py-1">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-2 py-1">Ngừng / Hết hạn</span>
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <form asp-action="Toggle" asp-route-id="@item.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") rounded-pill px-3" title="Bật/Tắt">
                                                @(item.IsActive ? "Tạm khóa" : "Kích hoạt")
                                            </button>
                                        </form>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa mã này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">Chưa có mã voucher nào được tạo!</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>