@model WebBanPC.Models.UserProfileVM
@{
    ViewData["Title"] = "Thông Tin Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-id-card me-2"></i>Hồ Sơ Cá Nhân</h5>
                </div>
                <div class="card-body p-4 p-md-5">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-4">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UserId" />

                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2">Thông Tin Cơ Bản</h6>
                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="FullName" class="form-label fw-bold"></label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control bg-light" readonly />
                            <small class="text-muted">Email dùng để đăng nhập và không thể thay đổi.</small>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="card bg-primary text-white text-center p-3 rounded-4 shadow-sm">
                                <h6><i class="fas fa-coins me-1 text-warning"></i> Điểm Thưởng TCSHOP</h6>
                                <h2 class="fw-bold mb-1">@Model.RewardPoints</h2>
                                <small class="text-light">Cứ 10 điểm = 1 lượt quay thưởng</small>
                                <a asp-controller="LuckyWheel" asp-action="Index" class="btn btn-warning btn-sm rounded-pill fw-bold text-dark mt-2">
                                    <i class="fas fa-dharmachakra me-1"></i> Quay Thưởng Ngay
                                </a>
                            </div>
                        </div>

                        HTML
                        <h6 class="text-primary fw-bold mb-3 border-bottom pb-2 pt-2">Đổi Mật Khẩu (Tùy chọn)</h6>

                        <!-- Ô input ảo đánh lừa tính năng Autofill của trình duyệt (tránh trình duyệt tự điền vào ô thật) -->
                        <input type="text" style="display:none;" aria-hidden="true" autocomplete="username">
                        <input type="password" style="display:none;" aria-hidden="true" autocomplete="new-password">

                        <div class="mb-3">
                            <label class="form-label fw-bold">Mật khẩu hiện tại (để trống nếu không đổi)</label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword"
                                       type="password"
                                       class="form-control"
                                       placeholder="Nhập mật khẩu hiện tại nếu muốn đổi..."
                                       autocomplete="new-password"
                                       value=""
                                       readonly
                                       onfocus="this.removeAttribute('readonly');" />
                                <button class="btn btn-outline-secondary btn-toggle-pw" type="button" tabindex="-1">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Mật khẩu mới</label>
                                <div class="input-group">
                                    <input asp-for="NewPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Nhập mật khẩu mới"
                                           autocomplete="new-password"
                                           value=""
                                           readonly
                                           onfocus="this.removeAttribute('readonly');" />
                                    <button class="btn btn-outline-secondary btn-toggle-pw" type="button" tabindex="-1">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Xác nhận mật khẩu mới</label>
                                <div class="input-group">
                                    <input asp-for="ConfirmNewPassword"
                                           type="password"
                                           class="form-control"
                                           placeholder="Nhập lại mật khẩu mới"
                                           autocomplete="new-password"
                                           value=""
                                           readonly
                                           onfocus="this.removeAttribute('readonly');" />
                                    <button class="btn btn-outline-secondary btn-toggle-pw" type="button" tabindex="-1">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-controller="TrangChu" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Quay Lại</a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                                <i class="fas fa-save me-1"></i> Lưu Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Xử lý nút ẩn / hiện mật khẩu
        $('.btn-toggle-pw').on('click', function () {
            let input = $(this).closest('.input-group').find('input');
            let icon = $(this).find('i');

            if (input.attr('type') === 'password') {
                input.attr('type', 'text');
                icon.removeClass('fa-eye').addClass('fa-eye-slash text-danger');
            } else {
                input.attr('type', 'password');
                icon.removeClass('fa-eye-slash text-danger').addClass('fa-eye');
            }
        });
    </script>
}