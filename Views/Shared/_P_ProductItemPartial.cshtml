@model WebBanPC.Models.Product

@{
    bool isEditMode = Context.Session.GetString("Admin_Visual_Edit_Mode") == "true"
                      && User.Identity?.IsAuthenticated == true
                      && User.IsInRole("Admin");
}
@{
    // Lấy ảnh đại diện chính (IsDefault == true) hoặc lấy ảnh đầu tiên, nếu không có lấy ảnh mặc định
    var mainImage = Model.ProductImages.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                    ?? Model.ProductImages.FirstOrDefault()?.ImageUrl
                    ?? "img/product-3.png";
}

<!-- 1. THÊM position-relative VÀO ĐÂY ĐỂ CÁC NÚT CÔNG CỤ ĐỊNH VỊ CHUẨN XÁC -->
<div class="col-lg-4 position-relative">

    <!-- 2. ĐẶT BẢNG NÚT SỬA/XÓA CỦA ADMIN VÀO ĐÂY (CHỈ HIỂN THỊ KHI Ở ADMIN EDIT MODE) -->
    @if (isEditMode)
    {
        <div class="position-absolute top-0 end-0 m-3 d-flex gap-1" style="z-index: 100;">
            <!-- Nút sửa sản phẩm -->
            <a asp-controller="AdminProduct" asp-action="Edit" asp-route-id="@Model.ProductId"
               target="_blank"
               class="btn btn-sm btn-warning rounded-circle shadow p-2"
               title="Sửa sản phẩm này">
                <i class="fas fa-pencil-alt"></i>
            </a>

            <!-- Nút xóa sản phẩm -->
            <form asp-controller="AdminProduct" asp-action="Delete" asp-route-id="@Model.ProductId" method="post"
                  onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi hệ thống?');" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger rounded-circle shadow p-2" title="Xóa sản phẩm">
                    <i class="fas fa-trash"></i>
                </button>
            </form>
        </div>
    }

    <div class="product-item rounded wow fadeInUp" data-wow-delay="0.1s">
        <div class="product-item-inner border rounded">
            <div class="product-item-inner-item">
                <img src="~/@mainImage" class="img-fluid w-100 rounded-top" alt="@Model.Name" style="height: 220px; object-fit: contain;">
                @if (Model.IsNew)
                {
                    <div class="product-new">New</div>
                }
                <div class="product-details">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">
                        <i class="fa fa-eye fa-1x"></i>
                    </a>
                </div>
            </div>
            <div class="text-center rounded-bottom p-4">
                <a href="#" class="d-block mb-2 text-muted">@Model.Category?.CategoryName</a>
                <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId" class="d-block h5 text-truncate" title="@Model.Name">
                    @Model.Name
                </a>
                <div class="mt-2">
                    @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
                    {
                        <del class="me-2 fs-6 text-muted">@Model.OldPrice.Value.ToString("N0") đ</del>
                    }
                    <span class="text-primary fs-5 fw-bold">@Model.Price.ToString("N0") đ</span>
                </div>
            </div>
        </div>
        <div class="product-item-add border border-top-0 rounded-bottom text-center p-4 pt-0">
            <button type="button"
                    class="btn btn-primary rounded-pill px-3 py-2 text-white border-0 btn-add-to-cart"
                    data-product-id="@Model.ProductId"
                    data-product-name="@Model.Name">
                <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
            </button>
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex">
                    <i class="fas fa-star text-primary"></i>
                    <i class="fas fa-star text-primary"></i>
                    <i class="fas fa-star text-primary"></i>
                    <i class="fas fa-star text-primary"></i>
                    <i class="fas fa-star text-secondary"></i>
                </div>
                <div class="d-flex">
                    <a href="#" class="text-primary d-flex align-items-center justify-content-center me-3">
                        <span class="rounded-circle btn-sm-square border"><i class="fas fa-random"></i></span>
                    </a>
                    <a href="#" class="text-primary d-flex align-items-center justify-content-center me-0">
                        <span class="rounded-circle btn-sm-square border"><i class="fas fa-heart"></i></span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>