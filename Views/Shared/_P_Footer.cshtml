                    <a href="#" class="mb-2 text-white"><i class="fas fa-angle-right me-2 text-primary"></i> Đánh Giá Từ Khách Hàng</a>
                    <a asp-controller="Account" asp-action="Profile" class="mb-2 text-white"><i class="fas fa-angle-right me-2 text-primary"></i> Tài Khoản Của Tôi</a>
                    <a href="#" class="mb-2 text-white"><i class="fas fa-angle-right me-2 text-primary"></i> Hủy Đăng Ký Thông Báo</a>
                </div>
            </div>

