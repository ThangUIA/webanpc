                    </a>
                    <a asp-controller="Home" asp-action="Faq" class="mb-2 text-white">
                        <i class="fas fa-angle-right me-2 text-primary"></i> Câu Hỏi Thường Gặp (FAQ)
                    </a>
                    <a asp-controller="Home" asp-action="PartnerPortal" class="mb-2 text-white">
