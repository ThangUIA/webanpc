                    </a>                    
                    <a asp-controller="Home" asp-action="TermsOfService" class="mb-2 text-white">
                        <i class="fas fa-angle-right me-2 text-primary"></i> Điều Khoản Dịch Vụ
                    </a>
                    <a asp-controller="Home" asp-action="WarrantyPolicy" class="mb-2 text-white">
