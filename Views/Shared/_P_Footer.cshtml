                    <a asp-controller="Cart" asp-action="Index" class="mb-2 text-white"><i class="fas fa-angle-right me-2 text-primary"></i> Giỏ Hàng Của Bạn</a>
                    <a asp-controller="Account" asp-action="MyOrders" class="mb-2 text-white"><i class="fas fa-angle-right me-2 text-primary"></i> Tra Cứu Đơn Hàng</a>
                </div>
