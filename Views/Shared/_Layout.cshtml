@using Microsoft.AspNetCore.Http
@{
    bool isEditMode = Context.Session.GetString("Admin_Visual_Edit_Mode") == "true"
                      && User.Identity?.IsAuthenticated == true
                      && User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8">
    <title>@ViewData["Title"] - TCSHOP Web Bán PC Và Linh Kiện MÁY Tính</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">

    <!-- Customized Bootstrap Stylesheet -->
    <link href="~/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="~/css/style.css" rel="stylesheet">
</head>

<body>
    <!-- 1. Thanh công cụ Admin Mode (Đặt chuẩn bên trong body) -->
    @if (isEditMode)
    {
        <div class="bg-dark text-white py-2 px-4 d-flex justify-content-between align-items-center shadow-lg position-sticky top-0" style="z-index: 1050; border-bottom: 2px solid #ffc107;">
            <div class="d-flex align-items-center">
                <span class="badge bg-warning text-dark me-2 fs-6"><i class="fas fa-tools me-1"></i> ADMIN EDIT MODE</span>
                <span class="small d-none d-md-inline">Bạn đang ở chế độ chỉnh sửa trực tiếp trên trang web.</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="AdminVoucher" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">
                    <i class="fas fa-ticket-alt me-1"></i> Quản Lý Voucher
                </a>
                <a asp-controller="AdminContact" asp-action="Index" class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold">
                    <i class="fas fa-envelope me-1"></i> Hộp Thư KH
                </a>
                <a asp-controller="AdminOrder" asp-action="Index" class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold">
                    <i class="fas fa-boxes me-1"></i> Quản Lý Đơn
                </a>
                <a asp-controller="AdminProduct" asp-action="Create" target="_blank" class="btn btn-sm btn-outline-light rounded-pill px-3">
                    <i class="fas fa-plus me-1"></i> Thêm SP Mới
                </a>
                <a asp-controller="AdminMode" asp-action="Disable" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-sm btn-danger rounded-pill px-3 fw-bold">
                    <i class="fas fa-times-circle me-1"></i> Thoát Quản Lý
                </a>
            </div>
        </div>
    }

    <!-- 2. Spinner: Đã tạm tắt để kiểm tra tốc độ nạp (Bỏ comment nếu muốn bật lại khi file JS đã ổn định) -->
    @* <partial name="_P_SpinnerStart" /> *@

    <!-- Topbar Start -->
    <partial name="_P_Topbar" />

    <!-- Navbar & Hero Start -->
    <partial name="_P_Navbar&Hero" />

    <!-- VÙNG NẠP NỘI DUNG CÁC TRANG CON -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer Start -->
    <partial name="_P_Footer" />

    <!-- Copyright Start -->
    <partial name="_P_Copyright" />

    <!-- Back to Top -->
    <a href="#" class="btn btn-primary btn-lg-square back-to-top"><i class="fa fa-arrow-up"></i></a>

    <!-- JavaScript Libraries -->
    <partial name="_P_JavaScript" />
    <script src="~/js/main.js"></script>

    <!-- Toast Giỏ hàng -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="cartToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body fs-6 py-3">
                    <i class="fas fa-check-circle me-2 fa-lg"></i>
                    <span id="toastMessage">Đã thêm vào giỏ hàng thành công!</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Script chung xử lý Giỏ hàng và Yêu thích (Gộp chung trong 1 block để tối ưu tài nguyên) -->
    <script>
        $(document).ready(function () {
            // Thêm vào giỏ hàng
            $(document).on('click', '.btn-add-to-cart', function (e) {
                e.preventDefault();
                var btn = $(this);
                var productId = btn.data('product-id');
                var originalHtml = btn.html();

                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i>Đang thêm...');

                $.ajax({
                    url: '/Cart/AddToCart',
                    type: 'POST',
                    data: { productId: productId, quantity: 1 },
                    success: function (res) {
                        btn.prop('disabled', false).html(originalHtml);
                        if (res.success) {
                            $('#toastMessage').text(res.message);
                            var toastEl = document.getElementById('cartToast');
                            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                            toast.show();
                            if (res.cartCount !== undefined) {
                                $('.cart-badge-count').text(res.cartCount);
                            }
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html(originalHtml);
                        alert('Có lỗi xảy ra khi thêm vào giỏ hàng!');
                    }
                });
            });

            // Toggle yêu thích (Wishlist)
            $(document).on('click', '.btn-toggle-wishlist', function (e) {
                e.preventDefault();
                var btn = $(this);
                var pId = btn.data('product-id');

                $.ajax({
                    url: '/Wishlist/ToggleWishlist',
                    type: 'POST',
                    data: { productId: pId },
                    success: function (res) {
                        if (res.success) {
                            var icon = btn.find('i.fa-heart');
                            if (res.isAdded) {
                                icon.addClass('text-danger');
                            } else {
                                icon.removeClass('text-danger');
                            }
                            alert(res.message);
                        } else {
                            alert(res.message);
                        }
                    },
                    error: function () {
                        alert('Có lỗi xảy ra khi cập nhật yêu thích!');
                    }
                });
            });
                        // Thêm vào so sánh
           $(document).on('click', '.btn-add-to-compare', function (e) {
            e.preventDefault();
            var pId = $(this).data('product-id');

            $.ajax({
                url: '/Compare/Add',
                type: 'POST',
                data: { productId: pId },
                success: function (res) {
                    alert(res.message);
                },
                error: function () {
                    alert('Có lỗi xảy ra khi thêm vào danh sách so sánh!');
                }
            });
          });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>