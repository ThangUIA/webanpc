@model WebBanPC.Models.CheckoutVM
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5 bg-dark mb-4">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Thanh Toán Đơn Hàng</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Giỏ Hàng</a></li>
        <li class="breadcrumb-item active text-white">Thanh Toán</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Checkout Page Start -->
<div class="container-fluid bg-light overflow-hidden py-4">
    <div class="container py-3">
        <h2 class="mb-4 text-primary"><i class="fas fa-file-invoice-dollar me-2"></i>Thông tin đặt hàng</h2>

        <form asp-action="Checkout" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-5">
                <!-- Cột trái: Form thông tin giao hàng -->
                <div class="col-md-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4">
                        <h4 class="mb-3">Địa chỉ nhận hàng</h4>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                            <input asp-for="CustomerName" class="form-control py-2" placeholder="Ví dụ: Nguyễn Văn A" />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerPhone" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                                <input asp-for="CustomerPhone" class="form-control py-2" placeholder="0987654321" />
                                <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerEmail" class="form-label fw-bold"></label>
                                <input asp-for="CustomerEmail" class="form-control py-2" placeholder="email@gmail.com" />
                                <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                            <input asp-for="ShippingAddress" class="form-control py-2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." />
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Note" class="form-label fw-bold"></label>
                            <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú về thời gian giao hàng hoặc chỉ dẫn thêm..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Bảng tóm tắt giỏ hàng & nút chuyển qua QR -->
                <div class="col-md-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4">
                        <h4 class="mb-3">Đơn hàng của bạn</h4>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.CartItems)
                                    {
                                        <tr>
                                            <td class="py-3">
                                                <div class="fw-bold">@item.Name</div>
                                                <small class="text-muted">Đơn giá: @item.Price.ToString("N0") đ</small>
                                            </td>
                                            <td class="text-center py-3">x @item.Quantity</td>
                                            <td class="text-end py-3 fw-bold">@item.Total.ToString("N0") đ</td>
                                        </tr>
                                    }
                                    <tr class="border-top">
                                        <td colspan="2" class="py-2 text-muted">Tạm tính:</td>
                                        <td class="text-end py-2 fw-bold">@Model.Subtotal.ToString("N0") đ</td>
                                    </tr>
                                    <tr>
                                        <td colspan="2" class="py-2 text-muted">Phí vận chuyển:</td>
                                        <td class="text-end py-2">@Model.ShippingFee.ToString("N0") đ</td>
                                    </tr>
                                    <tr class="border-top border-bottom">
                                        <td colspan="2" class="py-3"><h5 class="mb-0">Tổng thanh toán:</h5></td>
                                        <td class="text-end py-3"><h4 class="text-danger fw-bold mb-0">@Model.TotalAmount.ToString("N0") đ</h4></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Phần phương thức thanh toán: Chỉ giữ QR Code -->
                        <div class="alert alert-info border-0 rounded mt-3 d-flex align-items-center">
                            <i class="fas fa-qrcode fa-2x me-3 text-primary"></i>
                            <div>
                                <h6 class="mb-1 text-primary fw-bold">Thanh toán chuyển khoản qua mã QR Ngân Hàng</h6>
                                <small class="text-muted">Sau khi bấm Đặt Hàng, mã QR kèm thông tin thanh toán sẽ hiển thị để bạn quét bằng app ngân hàng.</small>
                            </div>
                        </div>

                        <div class="pt-3">
                            <button type="submit" class="btn btn-primary rounded-pill py-3 px-4 text-uppercase w-100 fw-bold fs-5 shadow">
                                <i class="fas fa-check-circle me-2"></i>Đặt hàng & Lấy mã QR
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Checkout Page End -->