@model WebBanPC.Models.CheckoutVM
@{
    ViewData["Title"] = "Thanh Toán Đơn Hàng";
}

<!-- Single Page Header start -->
<div class="container-fluid page-header py-5 bg-dark mb-4">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Thanh Toán Đơn Hàng</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index">Giỏ Hàng</a></li>
        <li class="breadcrumb-item active text-white">Thanh Toán</li>
    </ol>
</div>
<!-- Single Page Header End -->
<!-- Checkout Page Start -->
<div class="container-fluid bg-light overflow-hidden py-4">
    <div class="container py-3">
        <h2 class="mb-4 text-primary"><i class="fas fa-file-invoice-dollar me-2"></i>Thông tin đặt hàng</h2>

        <form asp-action="Checkout" method="post" id="checkoutForm">
            @Html.AntiForgeryToken()

            <!-- Các input ẩn để gửi mã giảm giá lên Controller xử lý lưu Database -->
            <input type="hidden" name="VoucherCode" id="hiddenVoucherCode" value="" />
            <input type="hidden" name="DiscountAmount" id="hiddenDiscountAmount" value="0" />

            <div class="row g-5">
                <!-- =================== CỘT TRÁI: ĐỊA CHỈ NHẬN HÀNG =================== -->
                <div class="col-md-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4">
                        <h4 class="mb-3">Địa chỉ nhận hàng</h4>
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CustomerName" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                            <input asp-for="CustomerName" class="form-control py-2" placeholder="Ví dụ: Nguyễn Văn A" />
                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerPhone" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                                <input asp-for="CustomerPhone" class="form-control py-2" placeholder="0987654321" />
                                <span asp-validation-for="CustomerPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CustomerEmail" class="form-label fw-bold"></label>
                                <input asp-for="CustomerEmail" class="form-control py-2" placeholder="email@gmail.com" />
                                <span asp-validation-for="CustomerEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ShippingAddress" class="form-label fw-bold"></label><span class="text-danger"> *</span>
                            <input asp-for="ShippingAddress" class="form-control py-2" placeholder="Số nhà, tên đường, phường/xã, quận/huyện..." />
                            <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Note" class="form-label fw-bold"></label>
                            <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú về thời gian giao hàng hoặc chỉ dẫn thêm..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- =================== CỘT PHẢI: CHI TIẾT ĐƠN HÀNG & VOUCHER =================== -->
                <div class="col-md-12 col-lg-6">
                    <div class="card border-0 shadow-sm p-4">
                        <h4 class="mb-3">Đơn hàng của bạn</h4>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-center">Số lượng</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CartItems != null && Model.CartItems.Any())
                                    {
                                        @foreach (var item in Model.CartItems)
                                        {
                                            <tr>
                                                <td class="py-3">
                                                    <div class="fw-bold">@item.Name</div>
                                                    <small class="text-muted">Đơn giá: @item.Price.ToString("N0") đ</small>
                                                </td>
                                                <td class="text-center py-3">x @item.Quantity</td>
                                                <td class="text-end py-3 fw-bold">@item.Total.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- KHỐI NHẬP MÃ GIẢM GIÁ (Đặt gọn gàng bên trong card) -->
                        <div class="my-3 p-3 bg-light rounded border">
                            <label class="form-label fw-bold text-dark small mb-2">
                                <i class="fas fa-tag text-warning me-1"></i> Mã giảm giá / Voucher
                            </label>
                            <div class="input-group">
                                <input type="text" id="voucherInput" class="form-control text-uppercase font-monospace" placeholder="Nhập mã voucher (nếu có)">
                                <button class="btn btn-outline-primary px-3 fw-bold" type="button" id="btnApplyVoucher">Áp dụng</button>
                            </div>
                            <div id="voucherAlert" class="small mt-2" style="display:none;"></div>
                        </div>

                        <!-- CỤM TỔNG TIỀN ĐỒNG BỘ ĐỘNG THEO MODEL -->
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Tạm tính:</span>
                            <span class="fw-bold" id="checkoutSubtotal">@Model.Subtotal.ToString("N0") đ</span>
                        </div>

                        <!-- Dòng Giảm giá từ Voucher (Mặc định ẩn, hiện khi mã hợp lệ) -->
                        <div class="d-flex justify-content-between mb-2 text-success" id="discountRow" style="display: none !important;">
                            <span>Voucher giảm giá (<strong id="appliedCodeText"></strong>):</span>
                            <span class="fw-bold" id="discountValue">-0 đ</span>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Phí vận chuyển:</span>
                            <span class="fw-bold" id="shippingFee">@Model.ShippingFee.ToString("N0") đ</span>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fs-5 fw-bold text-dark">Tổng thanh toán:</span>
                            <span class="fs-4 fw-bold text-danger" id="checkoutGrandTotal">@Model.TotalAmount.ToString("N0") đ</span>
                        </div>

                        <!-- Phương thức thanh toán QR Code -->
                        <div class="alert alert-info border-0 rounded d-flex align-items-center mb-3">
                            <i class="fas fa-qrcode fa-2x me-3 text-primary"></i>
                            <div>
                                <h6 class="mb-1 text-primary fw-bold">Thanh toán chuyển khoản qua mã QR Ngân Hàng</h6>
                                <small class="text-muted">Sau khi bấm Đặt Hàng, mã QR kèm thông tin thanh toán sẽ hiển thị để bạn quét bằng app ngân hàng.</small>
                            </div>
                        </div>

                        <!-- Nút Submit Đặt hàng -->
                        <div>
                            <button type="submit" class="btn btn-primary rounded-pill py-3 px-4 text-uppercase w-100 fw-bold fs-5 shadow">
                                <i class="fas fa-check-circle me-2"></i>Đặt hàng & Lấy mã QR
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>
<!-- Checkout Page End -->
@section Scripts {
    <script>
        // Lấy dữ liệu động từ Razor Model (Không bao giờ bị cứng số tiền)
        let rawSubtotal = @Model.Subtotal;
        let rawShipping = @Model.ShippingFee;
        let currentDiscount = 0;

        $('#btnApplyVoucher').click(function () {
            let code = $('#voucherInput').val().trim();
            let alertBox = $('#voucherAlert');

            if (!code) {
                alertBox.removeClass('text-success').addClass('text-danger').text('Vui lòng nhập mã voucher!').show();
                return;
            }

            $.ajax({
                url: '/Order/ApplyVoucher',
                type: 'POST',
                data: { code: code, subtotal: rawSubtotal },
                success: function (res) {
                    if (res.success) {
                        currentDiscount = res.discount;

                        // Hiển thị thông báo thành công
                        alertBox.removeClass('text-danger').addClass('text-success').text(res.message).show();

                        // Hiển thị dòng giảm giá
                        $('#discountRow').attr('style', 'display: flex !important;');
                        $('#appliedCodeText').text(res.voucherCode);
                        $('#discountValue').text('-' + currentDiscount.toLocaleString('vi-VN') + ' đ');

                        // Gán vào input hidden để gửi form lên Controller
                        $('#hiddenVoucherCode').val(res.voucherCode);
                        $('#hiddenDiscountAmount').val(currentDiscount);

                        // Tính lại tổng thanh toán mới
                        let newTotal = rawSubtotal + rawShipping - currentDiscount;
                        $('#checkoutGrandTotal').text(newTotal.toLocaleString('vi-VN') + ' đ');
                    } else {
                        // Reset lại nếu nhập mã sai/hết hạn
                        currentDiscount = 0;
                        $('#discountRow').attr('style', 'display: none !important;');
                        $('#hiddenVoucherCode').val('');
                        $('#hiddenDiscountAmount').val(0);

                        let originalTotal = rawSubtotal + rawShipping;
                        $('#checkoutGrandTotal').text(originalTotal.toLocaleString('vi-VN') + ' đ');
                        alertBox.removeClass('text-success').addClass('text-danger').text(res.message).show();
                    }
                },
                error: function () {
                    alertBox.removeClass('text-success').addClass('text-danger').text('Lỗi kết nối máy chủ!').show();
                }
            });
        });
    </script>
}