@model WebBanPC.Models.BannerCrudVM
@{
    ViewData["Title"] = "Thêm Banner";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="fas fa-plus me-2"></i>Thêm Banner Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="VD: GIÁ RẺ VÔ ĐỊCH" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Subtitle" class="form-label fw-bold"></label>
                            <input asp-for="Subtitle" class="form-control" placeholder="VD: Bảo hành chính hãng 36 tháng" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="LinkUrl" class="form-label fw-bold"></label>
                            <input asp-for="LinkUrl" class="form-control" placeholder="/Home/Index" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Position" class="form-label fw-bold"></label>
                                <select asp-for="Position" class="form-select">
                                    <option value="MainCarousel">Main Carousel (Slider trượt lớn)</option>
                                    <option value="HeaderRight">Header Right (Banner góc phải)</option>
                                    <option value="MidBanner">Mid Banner (Banner giữa trang)</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DisplayOrder" class="form-label fw-bold"></label>
                                <input asp-for="DisplayOrder" type="number" class="form-control" value="1" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-bold"></label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <span asp-validation-for="ImageFile" class="text-danger"></span>
                        </div>
                        <div class="form-check mb-4">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                            <button type="submit" class="btn btn-primary px-4 fw-bold">Lưu Banner</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>