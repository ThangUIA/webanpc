@model WebBanPC.Models.ProductDetailVM
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var defaultImg = p.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                     ?? p.ProductImages?.FirstOrDefault()?.ImageUrl
                     ?? "img/product-3.png";
}

<!-- Header Điều hướng (Breadcrumb) -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Chi Tiết Sản Phẩm</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Sản Phẩm</a></li>
        <li class="breadcrumb-item active text-white">@p.Name</li>
    </ol>
</div>

<!-- Khối Chi tiết Sản phẩm -->
<div class="container-fluid shop py-5">
    <div class="container py-5">
        <div class="row g-4">

            <!-- Cột Trái: Ảnh sản phẩm -->
            <div class="col-lg-5 col-xl-5">
                <div class="border rounded p-3 text-center bg-light">
                    <!-- Ảnh hiển thị chính -->
                    <img id="mainProductImg" src="~/@defaultImg" class="img-fluid rounded" style="max-height: 400px; object-fit: contain;" alt="@p.Name" />
                </div>

                <!-- Thumbnails nếu có nhiều ảnh -->
                @if (p.ProductImages != null && p.ProductImages.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3 overflow-auto">
                        @foreach (var img in p.ProductImages)
                        {
                            <img src="~/@img.ImageUrl"
                                 class="rounded border thumbnail-img"
                                 style="width: 75px; height: 75px; object-fit: contain; cursor: pointer;"
                                 onclick="$('#mainProductImg').attr('src', this.src)" />
                        }
                    </div>
                }
            </div>

            <!-- Cột Phải: Thông tin chi tiết & Đặt mua -->
            <div class="col-lg-7 col-xl-7">
                <h3 class="fw-bold mb-2">@p.Name</h3>

                <p class="mb-3 text-muted">
                    Danh mục: <strong class="text-primary">@(p.Category?.CategoryName ?? "Linh kiện PC")</strong>
                </p>

                <h4 class="fw-bold text-danger mb-3">@p.Price.ToString("N0") đ</h4>

                <div class="d-flex align-items-center mb-3">
                    <span class="text-warning me-2">
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                        <i class="fa fa-star"></i>
                    </span>
                    <small class="text-muted">(5.0 đánh giá từ khách hàng)</small>
                </div>

                <div class="mb-3 small">
                    <div class="mb-1">Mã SKU: <strong>@(string.IsNullOrWhiteSpace(p.Sku) ? "Chưa cập nhật" : p.Sku)</strong></div>
                    <div>
                        Tình trạng:
                        @if (p.StockQuantity > 0)
                        {
                            <span class="badge bg-success">Còn hàng (@p.StockQuantity sản phẩm)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Tạm hết hàng</span>
                        }
                    </div>
                </div>

                <p class="text-muted mb-4">
                    Cam kết hàng chính hãng 100%, bảo hành tiêu chuẩn từ nhà sản xuất. Hỗ trợ giao hàng nhanh toàn quốc.
                </p>

                <!-- Bộ đếm số lượng & Nút Thêm vào giỏ -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="btnQtyMinus"><i class="fa fa-minus"></i></button>
                        <input type="number" id="inputProductQty" class="form-control text-center form-control-sm" value="1" min="1" max="@(p.StockQuantity > 0 ? p.StockQuantity : 1)" />
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="btnQtyPlus"><i class="fa fa-plus"></i></button>
                    </div>

                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold btn-add-detail" data-product-id="@p.ProductId">
                        <i class="fa fa-shopping-bag me-2"></i> Thêm Vào Giỏ Hàng
                    </button>
                </div>

                <!-- Nút Yêu thích & So sánh nhanh -->
                <div class="d-flex align-items-center gap-3 pt-3 border-top">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill btn-toggle-wishlist" data-product-id="@p.ProductId">
                        <i class="fas fa-heart me-1"></i> Yêu Thích
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill btn-add-to-compare" data-product-id="@p.ProductId">
                        <i class="fas fa-random me-1"></i> So Sánh
                    </button>
                </div>
            </div>

            <!-- Tabs Mô tả sản phẩm -->
            <div class="col-12 mt-5">
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#tab-description" type="button">Mô Tả Sản Phẩm</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#tab-policy" type="button">Chính Sách Bảo Hành</button>
                    </li>
                </ul>
                <div class="tab-content border rounded p-4 bg-white">
                    <div class="tab-pane fade show active" id="tab-description">
                        @if (!string.IsNullOrWhiteSpace(p.ShortDescription))
                        {
                            <div>@Html.Raw(p.ShortDescription)</div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Thông số kỹ thuật và mô tả chi tiết của sản phẩm đang được cập nhật.</p>
                        }
                    </div>
                    <div class="tab-pane fade" id="tab-policy">
                        <ul class="mb-0">
                            <li>Bảo hành chính hãng 12 - 36 tháng theo quy định từng hãng.</li>
                            <li>Đổi mới trong vòng 30 ngày nếu phát sinh lỗi từ nhà sản xuất.</li>
                            <li>Hỗ trợ kiểm tra và vệ sinh máy miễn phí tại cửa hàng.</li>
                        </ul>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Sản Phẩm Liên Quan (Cùng Danh Mục) -->
@if (Model.RelatedProducts.Any())
{
    <div class="container-fluid related-product pb-5">
        <div class="container">
            <div class="text-center pb-4">
                <h4 class="text-primary border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">Sản Phẩm Tương Tự</h4>
            </div>
            <div class="row g-4">
                @foreach (var item in Model.RelatedProducts)
                {
                    <partial name="_P_ProductItemPartial" model="item" />
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Tăng giảm số lượng đặt mua
        $('#btnQtyMinus').on('click', function () {
            var val = parseInt($('#inputProductQty').val()) || 1;
            if (val > 1) $('#inputProductQty').val(val - 1);
        });

        $('#btnQtyPlus').on('click', function () {
            var val = parseInt($('#inputProductQty').val()) || 1;
            $('#inputProductQty').val(val + 1);
        });

        // Thêm vào giỏ hàng với số lượng tùy chọn
        $(document).on('click', '.btn-add-detail', function (e) {
            e.preventDefault();
            var pId = $(this).data('product-id');
            var qty = parseInt($('#inputProductQty').val()) || 1;

            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { productId: pId, quantity: qty },
                success: function (res) {
                    if (res.success) {
                        $('#toastMessage').text(res.message);
                        var toastEl = document.getElementById('cartToast');
                        if (toastEl) {
                            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                            toast.show();
                        } else {
                            alert(res.message);
                        }
                        if (res.cartCount !== undefined) {
                            $('.cart-badge-count').text(res.cartCount);
                        }
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi thêm vào giỏ hàng!');
                }
            });
        });
    </script>
}