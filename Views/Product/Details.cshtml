@model WebBanPC.Models.ProductDetailVM
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
    var defaultImg = p.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                     ?? p.ProductImages?.FirstOrDefault()?.ImageUrl
                     ?? "img/product-3.png";
    // Lấy điểm trung bình và tổng số lượt đánh giá đã tính từ Controller
    double avgRating = ViewBag.AverageRating != null ? (double)ViewBag.AverageRating : 0;
    int totalReviews = ViewBag.TotalReviews != null ? (int)ViewBag.TotalReviews : 0;
}

<!-- Header Điều hướng (Breadcrumb) -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Chi Tiết Sản Phẩm</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
        <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Sản Phẩm</a></li>
        <li class="breadcrumb-item active text-white">@p.Name</li>
    </ol>
</div>

<!-- Khối Chi tiết Sản phẩm -->
<div class="container-fluid shop py-5">
    <div class="container py-5">
        <div class="row g-4">

            <!-- Cột Trái: Ảnh sản phẩm -->
            <div class="col-lg-5 col-xl-5">
                <div class="border rounded p-3 text-center bg-light">
                    <!-- Ảnh hiển thị chính -->
                    <img id="mainProductImg" src="~/@defaultImg" class="img-fluid rounded" style="max-height: 400px; object-fit: contain;" alt="@p.Name" />
                </div>

                <!-- Thumbnails nếu có nhiều ảnh -->
                @if (p.ProductImages != null && p.ProductImages.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3 overflow-auto">
                        @foreach (var img in p.ProductImages)
                        {
                            <img src="~/@img.ImageUrl"
                                 class="rounded border thumbnail-img"
                                 style="width: 75px; height: 75px; object-fit: contain; cursor: pointer;"
                                 onclick="$('#mainProductImg').attr('src', this.src)" />
                        }
                    </div>
                }
            </div>

            <!-- Cột Phải: Thông tin chi tiết & Đặt mua -->
            <div class="col-lg-7 col-xl-7">
                <h3 class="fw-bold mb-2">@p.Name</h3>

                <p class="mb-3 text-muted">
                    Danh mục: <strong class="text-primary">@(p.Category?.CategoryName ?? "Linh kiện PC")</strong>
                </p>

                <h4 class="fw-bold text-danger mb-3">@p.Price.ToString("N0") đ</h4>

                <div class="d-flex align-items-center mb-3">
                    <div class="text-warning me-2">
                        @if (totalReviews == 0)
                        {
                            @* Chưa có đánh giá: hiển thị 5 sao rỗng *@
                            for (int i = 1; i <= 5; i++)
                            {
                                <i class="far fa-star text-muted"></i>
                            }
                        }
                        else
                        {
                            @* Đã có đánh giá: tô vàng theo điểm trung bình (hỗ trợ cả nửa sao) *@
                            for (int i = 1; i <= 5; i++)
                            {
                                if (avgRating >= i)
                                {
                                    <i class="fas fa-star text-warning"></i>
                                }
                                else if (avgRating >= i - 0.5)
                                {
                                    <i class="fas fa-star-half-alt text-warning"></i>
                                }
                                else
                                {
                                    <i class="far fa-star text-muted"></i>
                                }
                            }
                        }
                    </div>

                    <span class="text-muted small">
                        @if (totalReviews > 0)
                        {
                            <span>(@avgRating.ToString("0.0") dựa trên @totalReviews lượt đánh giá)</span>
                        }
                        else
                        {
                            <span>(Chưa có đánh giá)</span>
                        }
                    </span>
                </div>

                <div class="mb-3 small">
                    <div class="mb-1">Mã SKU: <strong>@(string.IsNullOrWhiteSpace(p.Sku) ? "Chưa cập nhật" : p.Sku)</strong></div>
                    <div>
                        Tình trạng:
                        @if (p.StockQuantity > 0)
                        {
                            <span class="badge bg-success">Còn hàng (@p.StockQuantity sản phẩm)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Tạm hết hàng</span>
                        }
                    </div>
                </div>

                <p class="text-muted mb-4">
                    Cam kết hàng chính hãng 100%, bảo hành tiêu chuẩn từ nhà sản xuất. Hỗ trợ giao hàng nhanh toàn quốc.
                </p>

                <!-- Bộ đếm số lượng & Nút Thêm vào giỏ -->
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="input-group" style="width: 130px;">
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="btnQtyMinus"><i class="fa fa-minus"></i></button>
                        <input type="number" id="inputProductQty" class="form-control text-center form-control-sm" value="1" min="1" max="@(p.StockQuantity > 0 ? p.StockQuantity : 1)" />
                        <button class="btn btn-outline-secondary btn-sm" type="button" id="btnQtyPlus"><i class="fa fa-plus"></i></button>
                    </div>

                    <button type="button" class="btn btn-primary rounded-pill px-4 py-2 fw-bold btn-add-detail" data-product-id="@p.ProductId">
                        <i class="fa fa-shopping-bag me-2"></i> Thêm Vào Giỏ Hàng
                    </button>
                </div>

                <!-- Nút Yêu thích & So sánh nhanh -->
                <div class="d-flex align-items-center gap-3 pt-3 border-top">
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill btn-toggle-wishlist" data-product-id="@p.ProductId">
                        <i class="fas fa-heart me-1"></i> Yêu Thích
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill btn-add-to-compare" data-product-id="@p.ProductId">
                        <i class="fas fa-random me-1"></i> So Sánh
                    </button>
                </div>
            </div>

            <!-- Tabs Mô tả sản phẩm -->
            <div class="col-12 mt-5">
                <ul class="nav nav-tabs mb-3" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active fw-bold" data-bs-toggle="tab" data-bs-target="#tab-description" type="button">Mô Tả Sản Phẩm</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link fw-bold" data-bs-toggle="tab" data-bs-target="#tab-policy" type="button">Chính Sách Bảo Hành</button>
                    </li>
                </ul>
                <div class="tab-content border rounded p-4 bg-white">
                    <div class="tab-pane fade show active" id="tab-description">
                        @if (!string.IsNullOrWhiteSpace(p.FullDescription))
                        {
                            <div>@Html.Raw(p.FullDescription)</div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Thông số kỹ thuật và mô tả chi tiết của sản phẩm đang được cập nhật.</p>
                        }
                    </div>
                    <div class="tab-pane fade" id="tab-policy">
                        <ul class="mb-0">
                            <li>Bảo hành chính hãng 12 - 36 tháng theo quy định từng hãng.</li>
                            <li>Đổi mới trong vòng 30 ngày nếu phát sinh lỗi từ nhà sản xuất.</li>
                            <li>Hỗ trợ kiểm tra và vệ sinh máy miễn phí tại cửa hàng.</li>
                        </ul>
                    </div>
                </div>
            </div>
            <!-- KHỐI BÌNH LUẬN VÀ ĐÁNH GIÁ -->
            <div class="card shadow-sm border-0 rounded-4 p-4 mt-5 bg-white">
                <div class="row">
                    <!-- Cột form gửi đánh giá -->
                    <div class="col-lg-5 mb-4 mb-lg-0 border-end">
                        <h4 class="fw-bold mb-3"><i class="fas fa-star text-warning me-2"></i>Đánh Giá Sản Phẩm</h4>

                        <div class="alert alert-light border d-flex align-items-center mb-3">
                            <i class="fas fa-user-circle fa-2x text-secondary me-2"></i>
                            <div>
                                <span class="small text-muted d-block">Bạn đang bình luận với tư cách:</span>
                                <strong class="text-primary">
                                    @(User.Identity != null && User.Identity.IsAuthenticated ? User.Identity.Name : "Khách vãng lai (Chưa đăng nhập)")
                                </strong>
                            </div>
                        </div>

                        <form id="reviewForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@Model.Product.ProductId" />

                            <!-- Chọn số sao đánh giá -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Chọn mức độ hài lòng:</label>
                                <div class="rating-stars fs-4 text-warning" style="cursor: pointer;">
                                    <i class="fas fa-star star-item" data-value="1"></i>
                                    <i class="fas fa-star star-item" data-value="2"></i>
                                    <i class="fas fa-star star-item" data-value="3"></i>
                                    <i class="fas fa-star star-item" data-value="4"></i>
                                    <i class="fas fa-star star-item" data-value="5"></i>
                                </div>
                                <input type="hidden" name="rating" id="selectedRating" value="5" />
                                <small id="ratingLabel" class="text-muted fw-bold">5 sao - Rất tuyệt vời</small>
                            </div>

                            <!-- Ô nhập nhận xét -->
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nội dung nhận xét:</label>
                                <textarea class="form-control" name="comment" id="commentText" rows="4" placeholder="Chia sẻ cảm nhận về hiệu năng, tản nhiệt, đóng gói của linh kiện này..." required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold">
                                <i class="fas fa-paper-plane me-1"></i> Gửi Đánh Giá
                            </button>
                        </form>
                    </div>

                    <!-- Cột danh sách các đánh giá đã có -->
                    <div class="col-lg-7 ps-lg-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="fw-bold mb-0">Nhận Xét Từ Khách Hàng</h4>
                            <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
                                Điểm: @ViewBag.AverageRating.ToString("0.0") / 5 <i class="fas fa-star text-warning"></i> (@ViewBag.TotalReviews lượt)
                            </span>
                        </div>

                        <div id="reviewsList" class="overflow-auto pe-2" style="max-height: 460px;">
                            @if (ViewBag.Reviews != null && ((List<WebBanPC.Models.ProductReview>)ViewBag.Reviews).Any())
                            {
                                foreach (var rev in (List<WebBanPC.Models.ProductReview>)ViewBag.Reviews)
                                {
                                    var author = rev.UserId.HasValue ? (rev.User?.FullName ?? "Thành viên") : (rev.GuestName ?? "Khách vãng lai");
                                    <div class="review-item border-bottom pb-3 mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-light text-primary d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px;">
                                                    @(rev.UserId.HasValue ? "TV" : "K")
                                                </div>
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@author</h6>
                                                    <small class="text-muted">@rev.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                                                </div>
                                            </div>
                                            <div class="text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= rev.Rating)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star text-muted"></i>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        <p class="text-dark mb-0 ps-5 ms-1">@rev.Comment</p>
                                    </div>
                                }
                            }
                            else
                            {
                                <div id="emptyReviewNotice" class="text-center py-5 text-muted">
                                    <i class="far fa-comments fa-3x mb-2 text-secondary"></i>
                                    <p>Chưa có đánh giá nào cho linh kiện này. Hãy là người đầu tiên chia sẻ cảm nhận!</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Sản Phẩm Liên Quan (Cùng Danh Mục) -->
@if (Model.RelatedProducts.Any())
{
    <div class="container-fluid related-product pb-5">
        <div class="container">
            <div class="text-center pb-4">
                <h4 class="text-primary border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">Sản Phẩm Tương Tự</h4>
            </div>
            <div class="row g-4">
                @foreach (var item in Model.RelatedProducts)
                {
                    <partial name="_P_ProductItemPartial" model="item" />
                }
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        // Tăng giảm số lượng đặt mua
        $('#btnQtyMinus').on('click', function () {
            var val = parseInt($('#inputProductQty').val()) || 1;
            if (val > 1) $('#inputProductQty').val(val - 1);
        });

        $('#btnQtyPlus').on('click', function () {
            var val = parseInt($('#inputProductQty').val()) || 1;
            $('#inputProductQty').val(val + 1);
        });

        // Thêm vào giỏ hàng với số lượng tùy chọn
        $(document).on('click', '.btn-add-detail', function (e) {
            e.preventDefault();
            var pId = $(this).data('product-id');
            var qty = parseInt($('#inputProductQty').val()) || 1;

            $.ajax({
                url: '/Cart/AddToCart',
                type: 'POST',
                data: { productId: pId, quantity: qty },
                success: function (res) {
                    if (res.success) {
                        $('#toastMessage').text(res.message);
                        var toastEl = document.getElementById('cartToast');
                        if (toastEl) {
                            var toast = new bootstrap.Toast(toastEl, { delay: 3000 });
                            toast.show();
                        } else {
                            alert(res.message);
                        }
                        if (res.cartCount !== undefined) {
                            $('.cart-badge-count').text(res.cartCount);
                        }
                    } else {
                        alert(res.message);
                    }
                },
                error: function () {
                    alert('Có lỗi xảy ra khi thêm vào giỏ hàng!');
                }
            });
        });
            const ratingTexts = {
            1: "1 sao - Rất tệ",
            2: "2 sao - Không hài lòng",
            3: "3 sao - Bình thường",
            4: "4 sao - Hài lòng",
            5: "5 sao - Rất tuyệt vời"
        };

        // Chọn số sao
        $('.star-item').on('click', function() {
            let val = $(this).data('value');
            $('#selectedRating').val(val);
            $('#ratingLabel').text(ratingTexts[val]);

            // Đổi màu sao
            $('.star-item').each(function() {
                let itemVal = $(this).data('value');
                if (itemVal <= val) {
                    $(this).removeClass('far text-muted').addClass('fas text-warning');
                } else {
                    $(this).removeClass('fas text-warning').addClass('far text-muted');
                }
            });
        });

        // Hover hiệu ứng sao
        $('.star-item').hover(
            function() {
                let val = $(this).data('value');
                $('.star-item').each(function() {
                    if ($(this).data('value') <= val) {
                        $(this).addClass('text-warning');
                    }
                });
            },
            function() {
                let currentSelected = $('#selectedRating').val();
                $('.star-item').each(function() {
                    if ($(this).data('value') > currentSelected) {
                        $(this).removeClass('text-warning').addClass('far text-muted');
                    }
                });
            }
        );

        // Gửi đánh giá qua AJAX
        $('#reviewForm').on('submit', function(e) {
            e.preventDefault();

            let formData = $(this).serialize();
            let submitBtn = $(this).find('button[type="submit"]');
            submitBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang gửi...');

            $.ajax({
                url: '/Product/AddReview',
                type: 'POST',
                data: formData,
                success: function(res) {
                    submitBtn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Gửi Đánh Giá');

                    if (res.success) {
                        $('#emptyReviewNotice').remove();

                        // Tạo HTML cụm sao
                        let starsHtml = '';
                        for (let i = 1; i <= 5; i++) {
                            if (i <= res.rating) {
                                starsHtml += '<i class="fas fa-star"></i>';
                            } else {
                                starsHtml += '<i class="far fa-star text-muted"></i>';
                            }
                        }

                        // Thêm bình luận mới lên đầu danh sách
                        let newReviewHtml = `
                            <div class="review-item border-bottom pb-3 mb-3 bg-light rounded p-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2 fw-bold" style="width: 36px; height: 36px;">
                                            ${res.reviewerName.substring(0, 2).toUpperCase()}
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold text-primary">${res.reviewerName} <span class="badge bg-success small">Mới</span></h6>
                                            <small class="text-muted">${res.date}</small>
                                        </div>
                                    </div>
                                    <div class="text-warning">${starsHtml}</div>
                                </div>
                                <p class="text-dark mb-0 ps-5 ms-1">${res.comment}</p>
                            </div>
                        `;

                        $('#reviewsList').prepend(newReviewHtml);
                        $('#commentText').val('');
                        alert(res.message);
                                // THÊM ĐOẠN NÀY VÀO ĐÂY:
                        setTimeout(function () {
                        location.reload();
                          }, 1000);
                    } else {
                        alert(res.message);
                    }
                },
                error: function() {
                    submitBtn.prop('disabled', false).html('<i class="fas fa-paper-plane me-1"></i> Gửi Đánh Giá');
                    alert('Có lỗi xảy ra, vui lòng thử lại!');
                }
            });
        });
    </script>
}