@model WebBanPC.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as List<WebBanPC.Models.Product> ?? new();
}

<!-- Single Page Header -->
<div class="container-fluid page-header py-5">
    <h1 class="text-center text-white display-6 wow fadeInUp" data-wow-delay="0.1s">Chi Tiết Linh Kiện</h1>
    <ol class="breadcrumb justify-content-center mb-0 wow fadeInUp" data-wow-delay="0.3s">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category?.CategoryName</a></li>
        <li class="breadcrumb-item active text-white">@Model.Name</li>
    </ol>
</div>

<!-- Single Products Start -->
<div class="container-fluid shop py-5">
    <div class="container py-5">
        <div class="row g-4">
            <!-- Cột trái: Sidebar ViewComponent chuẩn tỉ lệ col-lg-5 col-xl-3 -->
            <div class="col-lg-5 col-xl-3 wow fadeInUp" data-wow-delay="0.1s">
                @await Component.InvokeAsync("Sidebar")
            </div>

            <!-- Cột phải: Khu vực chi tiết sản phẩm col-lg-7 col-xl-9 -->
            <div class="col-lg-7 col-xl-9 wow fadeInUp" data-wow-delay="0.1s">
                <div class="row g-4 single-product">
                    <!-- Carousel ảnh & thumbnails -->
                    <div class="col-xl-6">
                        <div class="single-carousel owl-carousel">
                            @if (Model.ProductImages != null && Model.ProductImages.Any())
                            {
                                foreach (var img in Model.ProductImages)
                                {
                                    var fullImgPath = Url.Content("~/" + img.ImageUrl);
                                    <div class="single-item" data-dot="<img class='img-fluid' src='@fullImgPath' alt=''>">
                                        <div class="single-inner bg-light rounded text-center p-3">
                                            <img src="@fullImgPath" class="img-fluid rounded" alt="@Model.Name" style="height: 350px; object-fit: contain;">
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                var defaultImg = Url.Content("~/img/product-3.png");
                                <div class="single-item" data-dot="<img class='img-fluid' src='@defaultImg' alt=''>">
                                    <div class="single-inner bg-light rounded text-center p-3">
                                        <img src="@defaultImg" class="img-fluid rounded" alt="@Model.Name" style="height: 350px; object-fit: contain;">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Thông tin đặt hàng -->
                    <div class="col-xl-6">
                        <h4 class="fw-bold mb-3">@Model.Name</h4>
                        <p class="mb-3">Danh mục: <span class="text-primary fw-bold">@Model.Category?.CategoryName</span></p>

                        <div class="d-flex align-items-center mb-3">
                            <h4 class="fw-bold text-primary me-3 mb-0">@Model.Price.ToString("N0") đ</h4>
                            @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
                            {
                                <del class="text-muted fs-5">@Model.OldPrice.Value.ToString("N0") đ</del>
                            }
                        </div>

                        <div class="d-flex mb-4">
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                            <i class="fa fa-star text-secondary"></i>
                        </div>

                        <div class="mb-3">
                            <div class="btn btn-primary d-inline-block rounded text-white py-1 px-4 me-2">
                                <i class="fab fa-facebook-f me-1"></i> Share
                            </div>
                            <div class="btn btn-secondary d-inline-block rounded text-white py-1 px-4 ms-2">
                                <i class="fab fa-twitter ms-1"></i> Share
                            </div>
                        </div>

                        <div class="d-flex flex-column mb-3">
                            <small>Mã SKU: <strong>@Model.Sku</strong></small>
                            <small>Bảo hành: <strong>@Model.WarrantyMonths tháng</strong></small>
                            <small>
                                Tình trạng:
                                @if (Model.StockQuantity > 0)
                                {
                                    <strong class="text-primary">Còn hàng (@Model.StockQuantity sản phẩm)</strong>
                                }
                                else
                                {
                                    <strong class="text-danger">Tạm hết hàng</strong>
                                }
                            </small>
                        </div>

                        <p class="mb-4">@Model.ShortDescription</p>

                        <!-- Form thêm vào giỏ -->
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            <input type="hidden" name="productId" value="@Model.ProductId" />
                            <div class="input-group quantity mb-4" style="width: 120px;">
                                <div class="input-group-btn">
                                    <button type="button" class="btn btn-sm btn-minus rounded-circle bg-light border">
                                        <i class="fa fa-minus"></i>
                                    </button>
                                </div>
                                <input type="text" name="quantity" class="form-control form-control-sm text-center border-0" value="1">
                                <div class="input-group-btn">
                                    <button type="button" class="btn btn-sm btn-plus rounded-circle bg-light border">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary border border-secondary rounded-pill px-4 py-2 mb-4 text-white">
                                <i class="fa fa-shopping-bag me-2"></i> Thêm vào giỏ hàng
                            </button>
                        </form>
                    </div>

                    <!-- Tabs Thông số kỹ thuật & Bình luận -->
                    <div class="col-lg-12">
                        <nav>
                            <div class="nav nav-tabs mb-3">
                                <button class="nav-link active border-white border-bottom-0" type="button" data-bs-toggle="tab" data-bs-target="#nav-specs">Thông số kỹ thuật</button>
                                <button class="nav-link border-white border-bottom-0" type="button" data-bs-toggle="tab" data-bs-target="#nav-desc">Mô tả sản phẩm</button>
                                <button class="nav-link border-white border-bottom-0" type="button" data-bs-toggle="tab" data-bs-target="#nav-reviews">Đánh giá (Reviews)</button>
                            </div>
                        </nav>
                        <div class="tab-content mb-5">
                            <!-- Tab Thông số kỹ thuật -->
                            <div class="tab-pane active" id="nav-specs" role="tabpanel">
                                <table class="table table-bordered table-striped">
                                    <tbody>
                                        @if (Model.ProductAttributes != null && Model.ProductAttributes.Any())
                                        {
                                            foreach (var attr in Model.ProductAttributes)
                                            {
                                                <tr>
                                                    <th class="w-25 bg-light">@attr.Attribute?.AttributeName</th>
                                                    <td>@attr.Value</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr><td>Chưa có thông số kỹ thuật.</td></tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Tab Mô tả -->
                            <div class="tab-pane" id="nav-desc" role="tabpanel">
                                <div class="p-3 bg-light rounded">
                                    @Html.Raw(Model.FullDescription ?? "Nội dung đang cập nhật...")
                                </div>
                            </div>

                            <!-- Tab Bình luận -->
                            <div class="tab-pane" id="nav-reviews" role="tabpanel">
                                <div class="d-flex mb-4">
                                    <img src="~/img/avatar.jpg" class="img-fluid rounded-circle p-3" style="width: 100px; height: 100px;" alt="">
                                    <div>
                                        <p class="mb-2" style="font-size: 14px;">18/09/2026</p>
                                        <div class="d-flex justify-content-between">
                                            <h5>Nguyễn Văn A</h5>
                                            <div class="d-flex mb-3 text-secondary">
                                                <i class="fa fa-star text-primary"></i>
                                                <i class="fa fa-star text-primary"></i>
                                                <i class="fa fa-star text-primary"></i>
                                                <i class="fa fa-star text-primary"></i>
                                                <i class="fa fa-star"></i>
                                            </div>
                                        </div>
                                        <p>Linh kiện chạy rất êm và ổn định, shop giao hàng rất nhanh!</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Related Product Carousel -->
@if (relatedProducts.Any())
{
    <div class="container-fluid related-product">
        <div class="container">
            <div class="mx-auto text-center pb-5" style="max-width: 700px;">
                <h4 class="text-primary mb-4 border-bottom border-primary border-2 d-inline-block p-2 title-border-radius">Sản Phẩm Tương Tự</h4>
            </div>
            <div class="related-carousel owl-carousel pt-4">
                @foreach (var item in relatedProducts)
                {
                    <partial name="_P_ProductItemPartial" model="item" />
                }
            </div>
        </div>
    </div>
}