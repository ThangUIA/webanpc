@{
    ViewData["Title"] = "Giới Thiệu TCSHOP";
}

<!-- Breadcrumb Header -->
<div class="container-fluid page-header py-5 bg-dark mb-4">
    <h1 class="text-center text-white display-6">Giới Thiệu TCSHOP</h1>
    <ol class="breadcrumb justify-content-center mb-0">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white">Trang Chủ</a></li>
        <li class="breadcrumb-item text-white">Thông Tin Chung</li>
        <li class="breadcrumb-item active text-primary fw-bold">Giới Thiệu</li>
    </ol>
</div>

<div class="container py-4">
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-6">
            <h5 class="text-primary fw-bold text-uppercase">Về Chúng Tôi</h5>
            <h2 class="display-6 fw-bold mb-4">Đối Tác Công Nghệ Đáng Tin Cậy Của Game Thủ & Dân Đồ Họa</h2>
            <p class="text-muted" style="line-height: 1.8;">
                Thành lập với sứ mệnh mang đến những linh kiện máy tính chất lượng và giải pháp tối ưu nhất cho người dùng Việt Nam, <strong>TCSHOP</strong> tự hào là hệ thống bán lẻ linh kiện PC chính hãng uy tín hàng đầu.
            </p>
            <p class="text-muted" style="line-height: 1.8;">
                Tại TCSHOP, chúng tôi cung cấp từ CPU, VGA, Mainboard, RAM cho đến các bộ máy PC Gaming, Workstation cao cấp được build và tối ưu hóa chuẩn xác cho từng nhu cầu thực tế.
            </p>
            <div class="row g-3 pt-2">
                <div class="col-sm-6">
                    <div class="border rounded p-3 text-center bg-light">
                        <i class="fas fa-check-circle fa-2x text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">100% Chính Hãng</h6>
                        <small class="text-muted">Đầy đủ VAT & bảo hành</small>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="border rounded p-3 text-center bg-light">
                        <i class="fas fa-tools fa-2x text-primary mb-2"></i>
                        <h6 class="fw-bold mb-1">Hỗ Trợ Kỹ Thuật</h6>
                        <small class="text-muted">Lắp đặt & test máy free</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow rounded-3 overflow-hidden bg-light p-4 text-center">
                <i class="fas fa-desktop fa-5x text-primary mb-3"></i>
                <h4 class="fw-bold">TCSHOP</h4>
                <p class="text-muted mb-0">Hơn 5 năm đồng hành cùng hàng chục ngàn khách hàng trên cả nước.</p>
            </div>
        </div>
    </div>

    <!-- 3 Giá trị cốt lõi -->
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="fas fa-medal fa-2x text-primary"></i>
                </div>
                <h5 class="fw-bold">Chất Lượng Tiên Quyết</h5>
                <p class="text-muted small mb-0">Cam kết chỉ cung cấp linh kiện từ các nhà phân phối chính thức của Intel, AMD, ASUS, MSI, Gigabyte...</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="fas fa-dollar-sign fa-2x text-primary"></i>
                </div>
                <h5 class="fw-bold">Giá Cả Cạnh Tranh</h5>
                <p class="text-muted small mb-0">Luôn có các chương trình khuyến mãi, tặng voucher và chính sách giá tốt nhất cho khách hàng cá nhân lẫn doanh nghiệp.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 70px; height: 70px;">
                    <i class="fas fa-headset fa-2x text-primary"></i>
                </div>
                <h5 class="fw-bold">Tận Tâm Phục Vụ</h5>
                <p class="text-muted small mb-0">Đội ngũ kỹ thuật viên am hiểu phần cứng sẵn sàng tư vấn cấu hình phù hợp nhất với ngân sách của bạn.</p>
            </div>
        </div>
    </div>
</div>