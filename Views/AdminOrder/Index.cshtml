@model IEnumerable<WebBanPC.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng - Admin";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int? currentStatus = ViewBag.CurrentStatus;
    string? currentSearch = ViewBag.CurrentSearch;
}

<div class="container-fluid py-4 px-lg-5">
    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-1"><i class="fas fa-tasks me-2"></i>Quản Lý Đơn Hàng</h3>
            <p class="text-muted mb-0">Theo dõi, duyệt và xử lý các đơn hàng của khách hàng</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Về Trang Chủ
        </a>
    </div>

    <!-- Thông báo Alert -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-3 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Tìm theo Mã đơn, Tên khách, SĐT..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="1" selected="@(currentStatus == 1)">Chờ xác nhận</option>
                        <option value="2" selected="@(currentStatus == 2)">Đang giao hàng</option>
                        <option value="3" selected="@(currentStatus == 3)">Đã hoàn thành</option>
                        <option value="4" selected="@(currentStatus == 4)">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold flex-grow-1">
                        <i class="fas fa-filter me-1"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-light rounded-pill px-3 border" title="Đặt lại bộ lọc">
                        <i class="fas fa-redo-alt"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách đơn hàng -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-nowrap">
                    <tr>
                        <th class="ps-4">Mã Đơn</th>
                        <th>Ngày Đặt</th>
                        <th>Khách Hàng</th>
                        <th>Số Điện Thoại</th>
                        <th>Tổng Tiền</th>
                        <th>Trạng Thái</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">#@order.OrderId</td>
                                <td>@order.OrderDate?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="fw-bold">@order.CustomerName</td>
                                <td>@order.CustomerPhone</td>
                                <td class="fw-bold text-danger">@order.TotalAmount.ToString("N0") đ</td>
                                <td>
                                    @switch (order.OrderStatus)
                                    {
                                        case 1:
                                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill"><i class="fas fa-clock me-1"></i>Chờ xác nhận</span>
                                            break;
                                        case 2:
                                            <span class="badge bg-info text-dark px-3 py-2 rounded-pill"><i class="fas fa-shipping-fast me-1"></i>Đang giao hàng</span>
                                            break;
                                        case 3:
                                            <span class="badge bg-success px-3 py-2 rounded-pill"><i class="fas fa-check-circle me-1"></i>Đã hoàn thành</span>
                                            break;
                                        case 4:
                                            <span class="badge bg-danger px-3 py-2 rounded-pill"><i class="fas fa-times-circle me-1"></i>Đã hủy</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary px-3 py-2 rounded-pill">Khác</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center pe-4">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-bold">
                                        <i class="fas fa-eye me-1"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fas fa-box-open fa-3x mb-3 d-block text-secondary"></i>
                                Không tìm thấy đơn hàng nào phù hợp!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <ul class="pagination justify-content-center mb-0">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill me-1" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">«</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i" asp-route-search="@currentSearch" asp-route-status="@currentStatus">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill ms-1" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@currentSearch" asp-route-status="@currentStatus">»</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>