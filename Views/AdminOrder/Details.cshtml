@model WebBanPC.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.OrderId;
}

<div class="container py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-1">Đơn Hàng <span class="text-dark">#@Model.OrderId</span></h3>
            <small class="text-muted">Ngày đặt: @Model.OrderDate?.ToString("dd/MM/yyyy HH:mm:ss")</small>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Thông tin nhận hàng & Form Đổi trạng thái -->
        <div class="col-lg-4">
            <!-- Box Đổi Trạng Thái Nhanh -->
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i>Cập Nhật Trạng Thái</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="UpdateStatus" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="orderId" value="@Model.OrderId" />

                        <label class="form-label fw-bold small text-muted">Trạng thái hiện tại:</label>
                        <select name="newStatus" class="form-select mb-3">
                            <option value="1" selected="@(Model.OrderStatus == 1)">1. Chờ xác nhận</option>
                            <option value="2" selected="@(Model.OrderStatus == 2)">2. Đang giao hàng</option>
                            <option value="3" selected="@(Model.OrderStatus == 3)">3. Đã hoàn thành</option>
                            <option value="4" selected="@(Model.OrderStatus == 4)">4. Đã hủy</option>
                        </select>

                        <button type="submit" class="btn btn-primary rounded-pill w-100 fw-bold shadow-sm" onclick="return confirm('Bạn có chắc muốn chuyển trạng thái đơn hàng này?');">
                            <i class="fas fa-save me-1"></i> Lưu Cập Nhật
                        </button>
                    </form>
                </div>
            </div>

            <!-- Box Thông Tin Khách Hàng -->
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Thông Tin Người Nhận</h6>
                <p class="mb-2"><strong>Khách hàng:</strong> @Model.CustomerName</p>
                <p class="mb-2"><strong>Điện thoại:</strong> @Model.CustomerPhone</p>
                <p class="mb-2"><strong>Email:</strong> @Model.CustomerEmail</p>
                <p class="mb-2"><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p class="mb-0 text-muted"><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
        </div>

        <!-- Cột phải: Danh sách sản phẩm mua -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-3 p-4">
                <h6 class="fw-bold text-primary border-bottom pb-2 mb-3">Danh Sách Sản Phẩm</h6>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderDetails)
                            {
                                var img = item.Product?.ProductImages?.FirstOrDefault(x => x.IsDefault)?.ImageUrl
                                ?? item.Product?.ProductImages?.FirstOrDefault()?.ImageUrl
                                ?? "img/product-3.png";
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/@img" class="rounded me-3 border" style="width: 55px; height: 55px; object-fit: contain;" />
                                            <div>
                                                <div class="fw-bold">@item.Product?.Name</div>
                                                <small class="text-muted">Mã SKU: @item.Product?.Sku</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center fw-bold">x @item.Quantity</td>
                                    <td class="text-end fw-bold">@((item.UnitPrice * item.Quantity).ToString("N0")) đ</td>
                                </tr>
                            }
                            <tr class="border-top">
                                <td colspan="3" class="text-end py-3 fw-bold fs-6">Tổng Giá Trị Đơn Hàng:</td>
                                <td class="text-end py-3 fs-5 fw-bold text-danger">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>