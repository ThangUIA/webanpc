@model IEnumerable<WebBanPC.Models.ContactMessage>
@{
    ViewData["Title"] = "Hộp Thư Khách Hàng - Quản Trị";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    bool unreadOnly = ViewBag.UnreadOnly ?? false;
}

<div class="container-fluid py-4 px-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary fw-bold mb-1"><i class="fas fa-inbox me-2"></i>Hộp Thư Liên Hệ</h3>
            <p class="text-muted mb-0">Quản lý các phản hồi, góp ý và yêu cầu tư vấn từ khách hàng</p>
        </div>
        <div>
            <a asp-action="Index" asp-route-unreadOnly="@(!unreadOnly)" class="btn btn-outline-primary rounded-pill px-3 me-2">
                <i class="fas fa-filter me-1"></i> @(unreadOnly ? "Xem tất cả tin" : "Chỉ tin chưa đọc")
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="fas fa-arrow-left me-1"></i> Trang Chủ
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark text-nowrap">
                    <tr>
                        <th class="ps-4">Trạng Thái</th>
                        <th>Họ Tên</th>
                        <th>Email / SĐT</th>
                        <th>Chủ Đề</th>
                        <th>Ngày Gửi</th>
                        <th class="text-center pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr class="@(!item.IsRead ? "fw-bold table-warning bg-opacity-25" : "")">
                                <td class="ps-4">
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 py-1"><i class="fas fa-envelope me-1"></i>Chưa đọc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border rounded-pill px-2 py-1"><i class="fas fa-envelope-open me-1"></i>Đã đọc</span>
                                    }
                                </td>
                                <td>@item.Name</td>
                                <td>
                                    <div>@item.Email</div>
                                    <small class="text-muted">@(string.IsNullOrWhiteSpace(item.Phone) ? "Chưa cung cấp" : item.Phone)</small>
                                </td>
                                <td class="text-truncate" style="max-width: 250px;">
                                    @(string.IsNullOrWhiteSpace(item.Subject) ? "Không có chủ đề" : item.Subject)
                                </td>
                                <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary rounded-pill px-3">
                                            <i class="fas fa-eye me-1"></i> Xem
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa tin nhắn này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="fas fa-mail-bulk fa-3x mb-3 text-secondary d-block"></i>
                                Không có tin nhắn liên hệ nào!
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link rounded-pill mx-1" asp-action="Index" asp-route-page="@i" asp-route-unreadOnly="@unreadOnly">@i</a>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>